# Client Mode: Kupo target, either single instance or balancing server
KUPO_BASE_URL=localhost
KUPO_PORT=1442

# Server Mode: Configuration for server checks
KUPO_PY_ROLLBACK_SLOT=0
KUPO_PY_CHECK_INTERVAL=1             # how often to check for kupo liveness (seconds)
KUPO_PY_PATTERN_SYNC_INTERVAL=60     # how often to check for kupo server pattern synchronization
KUPO_PY_URL_1=http://localhost:1442  # first kupo server
KUPO_PY_URL_2=http://localhost:1443  # second kupo server
# KUPO_PY_URL_3=...                  # add any number of kupo servers
KUPO_PY_LOG_LEVEL=INFO               # Log level, options are DEBUG, INFO, WARNING, ERROR, CRITICAL

# DBSync configuration - used as a fallback for when Kupo is unavailable in server mode
DBSYNC_DB_NAME=cexplorer
DBSYNC_HOST=localhost
DBSYNC_PASS=pickabetterpassword
DBSYNC_PORT=5432
DBSYNC_USER=postgres